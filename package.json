{
  "name": "osa-agent-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint \"packages/**/*.ts\" \"db/**/*.ts\"",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_foundation.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seeds/001_reference_seed.sql",
    "db:rollback": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_foundation.down.sql"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
