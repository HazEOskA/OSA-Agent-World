{
  "name": "osa-agent-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint --no-error-on-unmatched-pattern \"packages/**/*.ts\" \"services/**/*.ts\" \"chain/**/*.ts\" \"tests/**/*.ts\" \"db/**/*.ts\" \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @osa/world dev",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "release:verify": "pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_foundation.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seeds/001_reference_seed.sql",
    "db:rollback": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_foundation.down.sql",
    "world:dev": "pnpm --filter @osa/world dev",
    "world:build": "pnpm --filter \"...@osa/world\" build"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
